{
  "name": "@rfnry/senses",
  "version": "0.1.2",
  "description": "Vision and speech interfaces for human-machine interaction",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rfnry/senses.git",
    "directory": "packages/typescript"
  },
  "homepage": "https://github.com/rfnry/senses/blob/main/docs/senses.md",
  "bugs": "https://github.com/rfnry/senses/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
